<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="pioneer3at">
  <xacro:include filename="../../bringup/description/pioneer3at_lidar.xacro"/>
  <xacro:arg name="use_rgbd" default="true"/>

  <gazebo reference="unilidar_lidar">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>11</update_rate>
      <topic>/lidar</topic>
      <gz_frame_id>unilidar_lidar</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>120</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>1.5708</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>30</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg use_rgbd)">
    <gazebo reference="camera_link">
      <sensor name="femto_bolt" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>8</update_rate>
        <topic>/femto_bolt</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.5</near>
              <far>3.86</far>
            </clip>
          </depth_camera>
          <optical_frame_id>camera_color_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>pioneer3at/odom</odom_frame>
      <robot_base_frame>pioneer3at/base_link</robot_base_frame>
      <odom_topic>/model/pioneer3at/odometry_ground_truth</odom_topic>
      <tf_topic>/model/pioneer3at/tf_ground_truth</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>
</robot>
