ARG TARGETARCH
ARG BASE_IMAGE=base-${TARGETARCH}

FROM osrf/ros:jazzy-desktop-full-noble AS base-amd64
FROM ros:jazzy-perception-noble AS base-arm64

FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y -o Acquire::http::Pipeline-Depth=0 --no-install-recommends neovim tree ros-jazzy-rviz2 ros-jazzy-rtabmap-ros python3-pip python3-numpy python3-serial python3-bleak && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --break-system-packages dynamic-object-removal==0.6.0

ARG PETE=false
ENV PETE_YOLO_MODEL=/opt/models/yolov8s-worldv2.pt OLLAMA_MODELS=/opt/models/ollama NVIDIA_DRIVER_CAPABILITIES=all
# Femto Bolt depth runs on the GPU through EGL and OpenGL, hence libegl1, libgl1 and the NVIDIA EGL vendor file
RUN if [ "$PETE" = "true" ]; then \
        apt-get update && apt-get install -y --no-install-recommends python3-pip git curl zstd libegl1 libgl1 && rm -rf /var/lib/apt/lists/* && \
        curl -fsSL https://ollama.com/install.sh | sh && \
        (ollama serve > /dev/null 2>&1 &) && sleep 5 && ollama pull qwen3-vl:2b-instruct && \
        pip install --no-cache-dir --break-system-packages --ignore-installed "numpy<2" ultralytics git+https://github.com/ultralytics/CLIP.git && \
        pip install --no-cache-dir --break-system-packages --no-deps pyorbbecsdk2 && \
        mkdir -p /usr/share/glvnd/egl_vendor.d && printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}' > /usr/share/glvnd/egl_vendor.d/10_nvidia.json && \
        yolo settings weights_dir=/opt/models/weights && \
        mkdir -p /opt/models && cd /opt/models && python3 -c "from ultralytics import YOLOWorld; YOLOWorld('yolov8s-worldv2.pt').set_classes(['chair'])"; \
    fi

ARG VOICE=false
# The voice nodes (ros/src/interaction/voice) need the audio libraries and the speech packages. The microphone and the speaker
# are not in the container: they come from the host's sound system (PipeWire) through a mounted socket, see start_voice_ros.sh.
# numpy stays below 2: the ROS packages (cv_bridge) are built against numpy 1. faster-whisper brings onnxruntime and the Silero
# voice-detection model, and runs Whisper on the CPU if the GPU server is missing.
# The robot speaks with a Piper neural voice (the default of voice.py, looked for in ~/.cache/piper); without it the listener
# falls back to the robotic espeak-ng voice, which is why espeak-ng stays installed.
RUN if [ "$VOICE" = "true" ]; then \
        apt-get update && apt-get install -y --no-install-recommends libportaudio2 libasound2-plugins pulseaudio-utils espeak-ng curl ca-certificates && rm -rf /var/lib/apt/lists/* && \
        python3 -m pip install --no-cache-dir --break-system-packages "numpy<2" sounddevice faster-whisper piper-tts && \
        mkdir -p /root/.cache/piper && cd /root/.cache/piper && \
        for file in en_GB-northern_english_male-medium.onnx en_GB-northern_english_male-medium.onnx.json; do \
            curl -fsSL -o $file https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_GB/northern_english_male/medium/$file; \
        done; \
    fi

RUN printf '\nsource /opt/ros/jazzy/setup.bash\nif [ -f /workspace/install/setup.bash ]; then source /workspace/install/setup.bash; fi\n' >> /etc/bash.bashrc

RUN printf '\nif command -v ollama > /dev/null && ! pgrep -x ollama > /dev/null; then (ollama serve > /tmp/ollama.log 2>&1 &); fi\n' >> /etc/bash.bashrc

WORKDIR /workspace
