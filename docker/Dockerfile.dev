# Jetson: ros:jazzy-perception-noble
ARG BASE_IMAGE=osrf/ros:jazzy-desktop-full-noble
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends neovim tree ros-jazzy-rtabmap-ros && rm -rf /var/lib/apt/lists/*

ARG PETE=false
ENV PETE_YOLO_MODEL=/opt/models/yolov8s-worldv2.pt OLLAMA_MODELS=/opt/models/ollama
RUN if [ "$PETE" = "true" ]; then \
        apt-get update && apt-get install -y --no-install-recommends python3-pip git curl zstd && rm -rf /var/lib/apt/lists/* && \
        curl -fsSL https://ollama.com/install.sh | sh && \
        (ollama serve > /dev/null 2>&1 &) && sleep 5 && ollama pull qwen3-vl:2b-instruct && \
        pip install --no-cache-dir --break-system-packages --ignore-installed "numpy<2" ultralytics git+https://github.com/ultralytics/CLIP.git && \
        yolo settings weights_dir=/opt/models/weights && \
        mkdir -p /opt/models && cd /opt/models && python3 -c "from ultralytics import YOLOWorld; YOLOWorld('yolov8s-worldv2.pt').set_classes(['chair'])"; \
    fi

RUN printf '\nsource /opt/ros/jazzy/setup.bash\nif [ -f /workspace/install/setup.bash ]; then source /workspace/install/setup.bash; fi\n' >> /etc/bash.bashrc

RUN printf '\nif command -v ollama > /dev/null && ! pgrep -x ollama > /dev/null; then (ollama serve > /tmp/ollama.log 2>&1 &); fi\n' >> /etc/bash.bashrc

WORKDIR /workspace
