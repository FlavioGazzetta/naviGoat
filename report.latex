\section{\textbf{Discussion and Future Work}}
%all the stretch goals 
% \begin{enumerate}
%     \item pole height adjustable 
%     \item Dog -\> Stairs
%     \item interface with google street map view (are we doing that ?) 
%     \item smart glasses 
